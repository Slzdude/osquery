prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: osquery SQL engine C wrapper for GhostTrace
Version: @OSQUERY_VERSION@
Requires:
Libs: -L${libdir} -losquery_wrapper -Wl,--whole-archive @SPECS_LIBS@ -Wl,--no-whole-archive -Wl,--allow-multiple-definition -Wl,--start-group @DEPS_LIBS@ @COMPAT_STUB@ -Wl,--end-group
Cflags: -I${includedir}
